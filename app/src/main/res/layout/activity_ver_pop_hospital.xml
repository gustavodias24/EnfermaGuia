<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".VerPopHospitalActivity">

    <!-- Conteúdo de procedimentos (mostrado após seleção) -->
    <LinearLayout
        android:id="@+id/layout_procedimentos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:fitsSystemWindows="true"
        android:orientation="vertical"
        android:paddingTop="?attr/actionBarSize"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Área rolável ocupa todo o espaço do container -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="12dp">
            <!-- (removido android:clipToPadding="false" para respeitar o padding do container) -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/compartilhar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#FFC107"
                    android:text="Compartilhar Selecionados"
                    android:textAllCaps="true"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:icon="@drawable/share"
                    app:iconGravity="textStart"
                    app:iconSize="15dp" />

                <Button
                    android:id="@+id/tutorial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:backgroundTint="@color/azul_fote"
                    android:drawableEnd="@drawable/baseline_help_outline_24"
                    android:drawableTint="#FFFFFF"
                    android:gravity="center"
                    android:text="Carregando..." />

                <TextView
                    android:id="@+id/textView7"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Procedimentos do Hospital "
                    android:textColor="#000000"
                    android:textSize="21sp" />

                <LinearLayout
                    android:id="@+id/layoutPesquisar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="12dp"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:elevation="4dp">

                    <!-- Título opcional -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Pesquisar procedimentos"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:layout_marginBottom="8dp" />

                    <!-- Modo de pesquisa -->
                    <RadioGroup
                        android:id="@+id/rgModoPesquisa"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <RadioButton
                            android:id="@+id/rbPorNome"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginEnd="16dp"
                            android:checked="true"
                            android:gravity="center"
                            android:text="Por nome" />

                        <RadioButton
                            android:id="@+id/rbDentroProcedimento"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="Dentro do procedimento" />
                    </RadioGroup>

                    <!-- Campo de busca -->
                    <EditText
                        android:id="@+id/edtPesquisar"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:hint="Digite aqui para pesquisar..."
                        android:inputType="text"
                        android:imeOptions="actionSearch"
                        android:drawableStart="@android:drawable/ic_menu_search"
                        android:drawablePadding="8dp"
                        android:layout_marginBottom="8dp" />

                    <!-- Botão de busca -->
                    <Button
                        android:id="@+id/buttonPesquisar"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:backgroundTint="@color/azul_fote"
                        android:onClick="pesquisarProcedimento"
                        android:text="Pesquisar"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />

                    <!-- Mensagem/estado -->
                    <TextView
                        android:id="@+id/textView12"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="Vazio"
                        android:textColor="@color/black" />
                </LinearLayout>


                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerProcedimentos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="ifContentScrolls"
                    android:paddingStart="12dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="4dp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
