<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:fitsSystemWindows="true"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="20dp">

    <LinearLayout
        android:id="@+id/layout"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        tools:context=".VerDetalheProcedimentoActivity">

        <Button
            android:id="@+id/darSugestao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:backgroundTint="@color/azul_fote"
            android:text="enviar sugestão"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:icon="@drawable/tip"
            app:iconGravity="textStart" />

        <Button
            android:id="@+id/tutorial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:backgroundTint="@color/azul_fote"
            android:drawableEnd="@drawable/baseline_help_outline_24"
            android:drawableTint="#FFFFFF"
            android:gravity="center"
            android:text="Ajuda" />


        <TextView
            android:id="@+id/textTituloHospital"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="8dp"
            android:text="loading..."
            android:textAllCaps="true"
            android:textColor="@color/azul_fote"
            android:textColorHint="#000000"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textTituloProcedimento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="8dp"
            android:text="loading..."
            android:textAllCaps="true"
            android:textColor="@color/azul_medio"
            android:textColorHint="#000000"
            android:textSize="34sp"
            android:textStyle="bold" />

        <LinearLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clique em "
                android:textAlignment="center"
                android:textColor="#000000" />

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@android:drawable/ic_input_add" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="e saiba mais"
                android:textAlignment="center"
                android:textColor="#000000" />
        </LinearLayout>

        <Button
            android:id="@+id/compartilhar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#FFC107"
            android:text="Compartilhar"
            android:textAllCaps="true"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:visibility="gone"
            app:icon="@drawable/share"
            app:iconGravity="textStart" />

        <!-- Espaço final para evitar que o último botão/texto fique colado às bordas/gestos -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="12dp" />

        <!-- bloco comentado preservado como no original -->

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
